{
  "name": "seat-reservation-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Modular Monolith Workplace Seat Reservation System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run build --workspace=packages/contracts && npm run build --workspace=apps/api && npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "clean": "rimraf --glob \"apps/*/dist\" \"packages/*/dist\" \"apps/*/*.tsbuildinfo\" \"packages/*/*.tsbuildinfo\" node_modules \"apps/*/node_modules\" package-lock.json"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^5.5.4",
    "rimraf": "^5.0.7",
    "prettier": "^3.3.3"
  },
  "overrides": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "ws": "^8.17.1",
    "body-parser": "^1.20.8",
    "multer": "^2.4.0",
    "qs": "^6.16.1",
    "lodash": "^4.18.1",
    "js-yaml": "^4.3.2",
    "glob": "^10.5.0",
    "tmp": "^0.2.7",
    "webpack": "^5.112.0",
    "ajv": "^8.20.0",
    "postcss-selector-parser": "^7.1.6",
    "esbuild": "^0.25.0",
    "file-type": "^21.3.4",
    "picomatch": "^2.3.1 || ^4.0.7"
  },
  "allowScripts": {
    "@nestjs/core": true,
    "@nestjs/core@10.4.22": true,
    "esbuild": true,
    "esbuild@0.21.5": true,
    "vue-demi": true,
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.6.0": true,
    "@scarf/scarf@1.4.0": true,
    "unrs-resolver@1.12.2": true
  }
}
