# Application Port
PORT=3000
NODE_ENV=development

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=seatadmin
DB_PASSWORD=seatsecret123
DB_NAME=seat_reservation_db
DATABASE_URL=postgresql://seatadmin:seatsecret123@localhost:5432/seat_reservation_db

# Security & JWT
JWT_SECRET=super-secret-dev-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=8h

# Uploads & Storage
UPLOAD_DEST=./uploads
STORAGE_MAX_FILE_SIZE_MB=10

# First-Run Setup Lock
SETUP_LOCK_FILE=./setup.lock

