# ==============================================================================
# Production Environment Configuration Template
# SeatSpace — Workplace Seat Reservation System
# Permissions: chmod 600 /etc/seat-reservation/api.env
# Owner: chown seatspace:seatspace /etc/seat-reservation/api.env
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Production Connection Settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=seatspace_app
DB_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_PASSWORD_MIN_32_CHARS
DB_NAME=seat_reservation_prod
DB_SSL=false
DATABASE_URL=postgresql://seatspace_app:REPLACE_WITH_HIGH_ENTROPY_PASSWORD_MIN_32_CHARS@127.0.0.1:5432/seat_reservation_prod

# Security & JWT Tokens (Must be a 64+ char random hex string in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_CRYPTOGRAPHICALLY_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# File Uploads & Storage Destination
UPLOAD_DEST=/var/www/seatspace/storage/uploads
STORAGE_MAX_FILE_SIZE_MB=10

# Security Lock Path (Must be writeable by service user)
SETUP_LOCK_FILE=/var/www/seatspace/storage/setup.lock

